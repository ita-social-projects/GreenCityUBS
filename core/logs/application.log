[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_templates (language_id, notification_type, title, body, notification_receiver_type) VALUES ('2', 'ORDER_IS_PAID', 'Payment successful', 'Hello! You have successfully purchased a “UBS Courier” service! UBS Courier will collect your bags within 2-9 days from the payment date. Once the route is created, we will contact you to confirm the details. We will gladly answer any questions you might still have! Chat with a manager t.me/nowaste_service_bot or email hello@nowaste.org.ua', 'OTHER')
[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m 1 row(s) affected
