[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_templates (language_id, notification_type, title, body, notification_receiver_type) VALUES ('1', 'UNPAID_PACKAGE', 'Оплатіть зміну у замовлені', 'Вітання! Ви внесли зміни у замовлення №${orderNumber}. Просимо вас, будь ласка, доплатити ${amountToPay} грн. Оплатити: [payButton]. Якщо у вас залишилися будь-які питання — з радістю відповім! Чат з менеджеркою t.me/nowaste_service_bot чи e-mail hello@nowaste.org.ua', 'OTHER')
