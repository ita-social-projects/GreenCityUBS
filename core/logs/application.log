[2025-10-29 17:20:27] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_templates (language_id, notification_type, title, body) VALUES ('1', 'UNPAID_ORDER', 'Неоплачене замовлення', 'Вітання! Ви нещодавно залишили заявку для замовлення нашої послуги «УБС Кур’єр», але ми не отримали підтвердження оплати. Можливо, у вас виникли якісь труднощі? Якщо у вас залишилися будь-які питання — з радістю відповім! Чат з менеджеркою t.me/nowaste_service_bot чи e-mail hello@nowaste.org.ua')
[2025-10-29 17:20:27] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m 1 row(s) affected
