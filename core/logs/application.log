[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.database                      [0;39m [35m:37  [0;39m Executing Statement: liquibase.statement.core.InsertStatement@616f08d6
[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_templates (language_id, notification_type, title, body, notification_receiver_type) VALUES ('2', 'ACCRUED_BONUSES_TO_ACCOUNT', 'Bonus points added', 'Hello! Amount of bags collected by your UBS Courier today: ${realPackageNumber}. However, you paid for: ${paidPackageNumber} bags. So we have credited your account with ${overpayment} UAH toward your next collection. Have a great day!', 'OTHER')
[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m 1 row(s) affected
