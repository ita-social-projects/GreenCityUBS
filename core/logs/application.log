[2025-10-29 17:20:27] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_templates (language_id, notification_type, title, body) VALUES ('2', 'ACCRUED_BONUSES_TO_ACCOUNT', 'Bonus points added', 'Hello! Amount of bags collected by your UBS Courier today: ${realPackageNumber}. However, you paid for: ${paidPackageNumber} bags. So we have credited your account with ${overpayment} UAH toward your next collection. Have a great day!')
