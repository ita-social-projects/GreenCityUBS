[2025-10-29 17:20:29] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_platforms (body, body_eng, notification_receiver_type, notification_status, notification_id) VALUES ('Вітання! Ви нещодавно залишили заявку для замовлення нашої послуги «УБС Кур’єр», але ми не отримали підтвердження оплати. Можливо, у вас виникли якісь труднощі? Якщо у вас залишилися будь-які питання — з радістю відповім! Чат з менеджеркою t.me/nowaste_service_bot чи e-mail hello@nowaste.org.ua', 'Hello! Recently you have requested our “UBS Courier” service, however, we have not received the payment confirmation. Did you happen to encounter any issues? We will gladly answer any questions you might still have! Chat with a manager t.me/nowaste_service_bot or email hello@nowaste.org.ua', 'EMAIL', 'ACTIVE', '1')
