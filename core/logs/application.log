[2025-10-29 17:20:27] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_templates (language_id, notification_type, title, body) VALUES ('1', 'VIOLATION_THE_RULES', 'Недотримання правил УБС', 'Вітання! На жаль, у ваших пакетах було виявлено: ${violationDescription}. Це відходи, які ми не приймаємо. Будь ласка, ознайомтеся ще раз із нашими правилами сортування: https://bit.ly/2Q2esLB НЕ приймаємо взагалі: -батарейки, акумулятори, ртутьвмісні (люмінесцентні) лампи й термометри; -ліки та фармацевтичні відходи (маски, рукавички, шприци), а також усе, що контактувало з рідинами тіла (кров’ю, сечею, слиною, виділеннями); -використані засоби особистої гігієни та контрацепції (підгузки, прокладки, тампони, презервативи тощо); -картриджі принтера; -будівельні відходи, лаки, фарби, пластилін; -недопалки/стіки від електронних аксесуарів для куріння; -газові балони, запальнички, вибухонебезпечні предмети (гільзи, снаряди тощо); -кераміку; -гострі та ріжучі предмети. Дякуємо за розуміння!')
[2025-10-29 17:20:27] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m 1 row(s) affected
[2025-10-29 17:20:27] [34mINFO[0;39m [36mliquibase.changelog                     [0;39m [35m:37  [0;39m New row inserted into notification_templates
[2025-10-29 17:20:27] [39mDEBUG[0;39m [36mliquibase.database                      [0;39m [35m:37  [0;39m Executing Statement: liquibase.statement.core.InsertStatement@67c55bd7
[2025-10-29 17:20:27] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_templates (language_id, notification_type, title, body) VALUES ('2', 'VIOLATION_THE_RULES', 'UBS Rules Violation', 'Hello! Unfortunately, your bags contained the following: ${violationDescription}. This is the type of waste we do not collect. Please familiarize yourself with our recycling rules once more: https://bit.ly/2Q2esLB We do NOT collect any type of the following waste: -batteries, accumulators (lead-acid batteries), mercury-containing (fluorescent) light bulbs and thermometers; -medicine and pharmaceutical waste (masks, gloves, syringes), and anything that came into contact with bodily fluids (blood, urine, saliva, bodily secretions); -personal hygiene and contraception items that have been used (diapers, pads, tampons, condoms, etc.); -printer cartridges; -construction waste, varnish, paint, plasticine; -cigarette butts/e-cigarettes and their accessories; -gas cylinders, lighters, explosive materials (shell casings, ammunition, etc.); -ceramics; -sharp and cutting objects. Thank you for your understanding!')
[2025-10-29 17:20:27] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m 1 row(s) affected
