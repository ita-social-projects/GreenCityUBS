[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.database                      [0;39m [35m:37  [0;39m Executing Statement: liquibase.statement.core.InsertStatement@137b0e6f
[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_templates (language_id, notification_type, title, body, notification_receiver_type) VALUES ('1', 'ORDER_IS_PAID', 'Оплата пройшла успішно', 'Вітаємо! Ви успішно замовили й оплатили послугу «УБС Кур''єр»! УБС Кур''єр приїде по ваші пакети впродовж 2–9 днів від дати оплати послуги. Коли маршрут буде сформовано, ми обов’язково зв''яжемося з вами для узгодження деталей. Якщо у вас залишилися будь-які питання — з радістю відповім! Чат з менеджеркою t.me/nowaste_service_bot чи e-mail hello@nowaste.org.ua', 'OTHER')
[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m 1 row(s) affected
