[2025-10-29 17:20:30] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m UPDATE public.notification_platforms SET body = 'На жаль, у ваших пакетах було виявлено: ${violationDescription} (замовлення №${orderNumber}). Це відходи, які ми не приймаємо. Будь ласка, ознайомтеся ще раз із нашими правилами сортування: https://bit.ly/2Q2esLB НЕ приймаємо взагалі: -батарейки, акумулятори, ртутьвмісні (люмінесцентні) лампи й термометри; -ліки та фармацевтичні відходи (маски, рукавички, шприци), а також усе, що контактувало з рідинами тіла (кров’ю, сечею, слиною, виділеннями); -використані засоби особистої гігієни та контрацепції (підгузки, прокладки, тампони, презервативи тощо); -картриджі принтера; -будівельні відходи, лаки, фарби, пластилін; -недопалки/стіки від електронних аксесуарів для куріння; -газові балони, запальнички, вибухонебезпечні предмети (гільзи, снаряди тощо); -кераміку; -гострі та ріжучі предмети. Дякуємо за розуміння!', body_eng = 'Unfortunately, your bags contained the following: ${violationDescription} (order №${orderNumber}). This is the type of waste we do not collect. Please familiarize yourself with our recycling rules once more: https://bit.ly/2Q2esLB We do NOT collect any type of the following waste:-batteries, accumulators (lead-acid batteries), mercury-containing (fluorescent) light bulbs and thermometers; -medicine and pharmaceutical waste (masks, gloves, syringes), and anything that came into contact with bodily fluids (blood, urine, saliva, bodily secretions); -personal hygiene and contraception items that have been used (diapers, pads, tampons, condoms, etc.); -printer cartridges; -construction waste, varnish, paint, plasticine; -cigarette butts/e-cigarettes and their accessories; -gas cylinders, lighters, explosive materials (shell casings, ammunition, etc.); -ceramics; -sharp and cutting objects. Thank you for your understanding!' WHERE id = 16 AND notification_receiver_type = 'EMAIL' AND body = 'Вітання! На жаль, у ваших пакетах було виявлено: ${violationDescription} (замовлення №${orderNumber}). Це відходи, які ми не приймаємо. Будь ласка, ознайомтеся ще раз із нашими правилами сортування: https://bit.ly/2Q2esLB НЕ приймаємо взагалі: -батарейки, акумулятори, ртутьвмісні (люмінесцентні) лампи й термометри; -ліки та фармацевтичні відходи (маски, рукавички, шприци), а також усе, що контактувало з рідинами тіла (кров’ю, сечею, слиною, виділеннями); -використані засоби особистої гігієни та контрацепції (підгузки, прокладки, тампони, презервативи тощо); -картриджі принтера; -будівельні відходи, лаки, фарби, пластилін; -недопалки/стіки від електронних аксесуарів для куріння; -газові балони, запальнички, вибухонебезпечні предмети (гільзи, снаряди тощо); -кераміку; -гострі та ріжучі предмети. Дякуємо за розуміння!' AND body_eng = 'Hello! Unfortunately, your bags contained the following: ${violationDescription} (order №${orderNumber}). This is the type of waste we do not collect. Please familiarize yourself with our recycling rules once more: https://bit.ly/2Q2esLB We do NOT collect any type of the following waste:-batteries, accumulators (lead-acid batteries), mercury-containing (fluorescent) light bulbs and thermometers; -medicine and pharmaceutical waste (masks, gloves, syringes), and anything that came into contact with bodily fluids (blood, urine, saliva, bodily secretions); -personal hygiene and contraception items that have been used (diapers, pads, tampons, condoms, etc.); -printer cartridges; -construction waste, varnish, paint, plasticine; -cigarette butts/e-cigarettes and their accessories; -gas cylinders, lighters, explosive materials (shell casings, ammunition, etc.); -ceramics; -sharp and cutting objects. Thank you for your understanding!'
