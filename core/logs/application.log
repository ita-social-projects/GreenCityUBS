[2025-10-29 17:20:29] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_platforms (body, body_eng, notification_receiver_type, notification_status, notification_id) VALUES ('Вітаємо! Ви успішно замовили й оплатили послугу «УБС Кур''єр»! УБС Кур''єр приїде по ваші пакети впродовж 2–9 днів від дати оплати послуги. Коли маршрут буде сформовано, ми обов’язково зв''яжемося з вами для узгодження деталей. Якщо у вас залишилися будь-які питання — з радістю відповім! Чат з менеджеркою t.me/nowaste_service_bot чи e-mail hello@nowaste.org.ua', 'Hello! You have successfully purchased a “UBS Courier” service! UBS Courier will collect your bags within 2-9 days from the payment date. Once the route is created, we will contact you to confirm the details. We will gladly answer any questions you might still have! Chat with a manager t.me/nowaste_service_bot or email hello@nowaste.org.ua', 'EMAIL', 'ACTIVE', '2')
