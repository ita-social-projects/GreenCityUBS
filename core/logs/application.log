[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_templates (language_id, notification_type, title, body, notification_receiver_type) VALUES ('2', 'UNPAID_ORDER', 'Unpaid order', 'Hello! Recently you have requested our “UBS Courier” service, however, we have not received the payment confirmation. Did you happen to encounter any issues? We will gladly answer any questions you might still have! Chat with a manager t.me/nowaste_service_bot or email hello@nowaste.org.ua', 'OTHER')
