[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_templates (language_id, notification_type, title, body, notification_receiver_type) VALUES ('1', 'ACCRUED_BONUSES_TO_ACCOUNT', 'Нараховано бонуси', 'Вітання! Сьогодні УБС Кур’єр забрав у вас пакетів: ${realPackageNumber}. А оплачували ви: ${paidPackageNumber}. Тож фіксуємо для вас депозит для наступного вивозу на суму ${overpayment} грн. Гарного дня!', 'OTHER')
