[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_templates (language_id, notification_type, title, body, notification_receiver_type) VALUES ('2', 'VIOLATION_THE_RULES', 'UBS Rules Violation', 'Hello! Unfortunately, your bags contained the following: ${violationDescription}. This is the type of waste we do not collect. Please familiarize yourself with our recycling rules once more: https://bit.ly/2Q2esLB We do NOT collect any type of the following waste: -batteries, accumulators (lead-acid batteries), mercury-containing (fluorescent) light bulbs and thermometers; -medicine and pharmaceutical waste (masks, gloves, syringes), and anything that came into contact with bodily fluids (blood, urine, saliva, bodily secretions); -personal hygiene and contraception items that have been used (diapers, pads, tampons, condoms, etc.); -printer cartridges; -construction waste, varnish, paint, plasticine; -cigarette butts/e-cigarettes and their accessories; -gas cylinders, lighters, explosive materials (shell casings, ammunition, etc.); -ceramics; -sharp and cutting objects. Thank you for your understanding!', 'OTHER')
