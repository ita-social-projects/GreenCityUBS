[2025-10-29 17:20:29] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m INSERT INTO public.notification_platforms (body, body_eng, notification_receiver_type, notification_status, notification_id) VALUES ('Вітання! Ми сформували маршрут УБС Кур’єра. Наш Кур’єр буде у вас завтра, ${date}>. Робочий час Кур''єра: з ${startTime} до ${endTime}. Будь ласка, залишайтеся в цей час на зв’язку й увімкніть телефон на гучний режим. Кур''єр зателефонує вам заздалегідь та коли приїде. Якщо вам не вдасться бути на місці в домовлений час, ви можете залишити ваші пакети в консьєржа, але обов''язково попередьте про це Кур''єра або менеджерів! Номер Кур''єра — ${phoneNumber}. Якщо у вас залишилися будь-які питання — з радістю відповім! Чат з менеджеркою t.me/nowaste_service_bot чи e-mail hello@nowaste.org.ua', 'Hello! We have created the route for your UBS Courier. Your Courier will arrive tomorrow ${date}. Courier’s hours of operation: from ${startTime} to ${endTime}. Please be available during this time frame and make sure your phone is not on “silent”. The Courier will call you in advance, and upon arrival. If you are unable to be present during the agreed time, you may leave your bags with the concierge, but please, do notify your Courier or one of the managers! Courier’s number - ${phoneNumber}. We will gladly answer any questions you might still have! Chat with a manager t.me/nowaste_service_bot or email hello@nowaste.org.ua', 'EMAIL', 'ACTIVE', '3')
