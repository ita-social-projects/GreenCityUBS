[2025-10-29 17:20:28] [39mDEBUG[0;39m [36mliquibase.database                      [0;39m [35m:37  [0;39m Executing Statement: CREATE OR REPLACE FUNCTION  calculate_sum_total_amount_without_discounts_for_bag() RETURNS TRIGGER AS $orders$
            BEGIN
            if(TG_OP = 'UPDATE' OR TG_OP = 'INSERT') THEN
            UPDATE orders o
            SET sum_total_amount_without_discounts = (SELECT sum (obm.amount*b.full_price)
            FROM order_bag_mapping obm
            INNER JOIN bag b on obm.bag_id = b.id
            WHERE order_id = o.id)
            WHERE order_payment_status != 'PAID'
            AND order_payment_status != 'CANCELED';
            RETURN NEW ;
            END IF;
            RETURN null;
            END
            $orders$ LANGUAGE plpgsql
