[2025-10-29 17:20:30] [39mDEBUG[0;39m [36mliquibase.executor                      [0;39m [35m:37  [0;39m UPDATE public.notification_platforms SET body = 'Дякуємо за Ваше замовлення на нашому сайті! Ми раді повідомити, що Ваше замовлення №${orderNumber} на суму ${amountToPay} грн. було успішно розміщене та обробляється. Якщо у вас залишилися будь-які питання — з радістю відповімо! Чат з менеджером t.me/nowaste_service_bot чи e-mail hello@nowaste.org.ua', body_eng = 'Thank you for your order on our website! We are pleased to inform you that your order №${orderNumber} for the amount of ${amountToPay} UAH has been successfully placed and is being processed. If you have any questions, we are happy to assist! You can chat with a manager at t.me/nowaste_service_bot or email us at hello@nowaste.org.ua' WHERE id = 44 AND notification_receiver_type = 'EMAIL' AND body = 'Шановний(-а) ${customerName}, Дякуємо за Ваше замовлення на нашому сайті! Ми раді повідомити, що Ваше замовлення №${orderNumber} на суму ${amountToPay} грн. було успішно розміщене та обробляється. Якщо у вас залишилися будь-які питання — з радістю відповімо! Чат з менеджером t.me/nowaste_service_bot чи e-mail hello@nowaste.org.ua.' AND body_eng = 'Dear ${customerName}, Thank you for your order on our website! We are pleased to inform you that your order №${orderNumber} for the amount of ${amountToPay} UAH has been successfully placed and is being processed. If you have any questions, we are happy to assist! You can chat with a manager at t.me/nowaste_service_bot or email us at hello@nowaste.org.ua.'
