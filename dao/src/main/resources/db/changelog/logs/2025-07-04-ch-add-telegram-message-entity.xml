<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="2025-07-04-drop-tables" author="vovasaienko">
        <dropTable tableName="image"/>
        <dropTable tableName="text_message"/>
    </changeSet>

    <changeSet id="2025-07-03-create-telegram-message-and-assets" author="vovasaienko">

        <modifyDataType
                tableName="telegram_message"
                columnName="chat_id"
                newDataType="BIGINT"/>

        <renameColumn
                tableName="telegram_message"
                oldColumnName="message_id"
                newColumnName="id"
                columnDataType="BIGINT"/>

        <addColumn tableName="telegram_message">
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(255)"/>
            <column name="from_manager" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="text" type="VARCHAR(1000)"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="telegram_message"
                baseColumnNames="chat_id"
                constraintName="fk_telegram_message_chat"
                referencedTableName="telegram_chat"
                referencedColumnNames="id"/>


        <createTable tableName="message_asset">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="file_name" type="VARCHAR(255)"/>
            <column name="size" type="BIGINT"/>
            <column name="content_type" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="message_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="message_asset"
                baseColumnNames="message_id"
                constraintName="fk_message_asset_message"
                referencedTableName="telegram_message"
                referencedColumnNames="id"/>
    </changeSet>


</databaseChangeLog>
