<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="changeUsersAddUserStatusColumnZadyraichuk" author="Rostyslav Zadyraichuk">
        <addColumn tableName="users">
            <column name="user_status" type="VARCHAR(30)" defaultValue="ACTIVATED">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <update tableName="users">
            <column name="user_status" value="ACTIVATED"/>
        </update>

        <rollback>
            <dropColumn tableName="users" columnName="user_status"/>
        </rollback>
    </changeSet>
</databaseChangeLog>