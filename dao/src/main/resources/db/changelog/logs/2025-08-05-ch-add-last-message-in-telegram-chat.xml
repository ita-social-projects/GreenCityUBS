<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="add-last-message-to-telegram-chat" author="Anton Pampukha">
        <addColumn tableName="telegram_chat">
            <column name="last_message_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="telegram_chat"
                baseColumnNames="last_message_id"
                referencedTableName="telegram_message"
                referencedColumnNames="id"
                constraintName="fk_telegram_chat_last_message"
                deferrable="false"
                initiallyDeferred="false"
                onDelete="SET NULL"/>

        <createIndex
                tableName="telegram_chat"
                indexName="idx_telegram_chat_last_message">
            <column name="last_message_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

