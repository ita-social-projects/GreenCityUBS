<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="add-pickup-user" author="Pohranychnyi Oleksandr">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM users WHERE recipient_email = 'pickup@nowaste.org.ua';
                </sqlCheck>
            </not>
        </preConditions>

        <insert tableName="users">
            <column name="current_points" value="0"/>
            <column name="uuid" value="d0840b34-3f17-4820-a375-305b855dff8b"/>
            <column name="violations" value="0"/>
            <column name="recipient_name" value="ADMIN"/>
            <column name="recipient_email" value="pickup@nowaste.org.ua"/>
            <column name="recipient_phone" value="+380675554433"/>
            <column name="recipient_surname" value="UBS"/>
            <column name="date_of_registration" value="1970-01-01 00:00:00.000000"/>
        </insert>

    </changeSet>
</databaseChangeLog>