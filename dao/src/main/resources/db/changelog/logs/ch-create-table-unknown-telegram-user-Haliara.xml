<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-unknown-telegram-user-table" author="Vladyslav Haliara">
        <createTable tableName="unknown_telegram_user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="chat_id" type="VARCHAR(55)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="is_support_status_active" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(255)"/>
            <column name="mobile_number" type="VARCHAR(255)"/>
        </createTable>
        <createIndex tableName="unknown_telegram_user" indexName="idx_unknown_telegram_user_chat_id">
            <column name="chat_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>