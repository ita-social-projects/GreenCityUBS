<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="001-create-notification_timestamp" author="Vlad Haliara">
        <createTable tableName="notification_timestamp">
            <column name="chat_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="last_notification_time" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-pending_message" author="Vlad Haliara">
        <createTable tableName="pending_message">
            <column name="chat_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="message_count" type="INT"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
