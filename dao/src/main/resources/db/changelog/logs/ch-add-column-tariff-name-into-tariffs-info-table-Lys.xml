<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="add-new-column-tariff-name-1" author="BohdanLys">
        <addColumn tableName="tariffs_info">
            <column name="tariff_name_en" type="VARCHAR(255)"/>
            <column name="tariff_name_uk" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="add-new-column-tariff-name-2" author="BohdanLys">
        <update tableName="tariffs_info">
            <column name="tariff_name_en" value="Kyiv"/>
            <column name="tariff_name_uk" value="Київ"/>
            <where>id = 1</where>
        </update>
        <update tableName="tariffs_info">
            <column name="tariff_name_en" value="Kyiv Oblast"/>
            <column name="tariff_name_uk" value="Київська область"/>
            <where>id = 2</where>
        </update>
    </changeSet>

    <changeSet id="add-new-column-tariff-name-3" author="BohdanLys">
        <update tableName="tariffs_info">
            <column name="tariff_name_en" value="Unnamed tariff"/>
            <where>tariff_name_en IS NULL</where>
        </update>
        <update tableName="tariffs_info">
            <column name="tariff_name_uk" value="Без назви тариф"/>
            <where>tariff_name_uk IS NULL</where>
        </update>
        <addNotNullConstraint tableName="tariffs_info" columnName="tariff_name_en" columnDataType="VARCHAR(255)"/>
        <addNotNullConstraint tableName="tariffs_info" columnName="tariff_name_uk" columnDataType="VARCHAR(255)"/>
    </changeSet>
</databaseChangeLog>