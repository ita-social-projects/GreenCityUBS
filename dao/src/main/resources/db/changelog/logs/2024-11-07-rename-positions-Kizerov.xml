<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2024-11-07-rename-positions" author="Kizerov Dmytro">
        <update tableName="positions">
            <column name="name_eng" value="Manager"/>
            <where>name_eng = 'Call Manager'</where>
        </update>

        <update tableName="positions">
            <column name="name" value="Менеджер"/>
            <where>name = 'Менеджер обзвону'</where>
        </update>
    </changeSet>
</databaseChangeLog>